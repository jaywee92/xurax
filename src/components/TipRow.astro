---
import { sourcesFor, type Tip } from '../lib/tips';

interface Props {
  tip: Tip;
  n: number;
}

const { tip, n } = Astro.props;
const sources = sourcesFor(tip);
---

<article class="tip-row" id={tip.id} data-level={tip.level}>
  <a class="n" href={`#${tip.id}`} aria-label={`Link zu Tipp ${n}`}>{String(n).padStart(2, '0')}</a>
  <div>
    <h3>{tip.title} <span class={`badge badge-${tip.level.toLowerCase()}`}>{tip.level}</span></h3>
    <p>{tip.text}</p>
    {sources.length > 0 && (
      <p class="src">
        Quelle:{' '}
        {sources.map((s, i) => (
          <>
            {i > 0 && ', '}
            <a href={s.url} rel="noopener">{s.title}</a> ({s.type})
          </>
        ))}
      </p>
    )}
  </div>
</article>
