---
import { sourcesFor, type Tip } from '../lib/tips';

interface Props {
  tip: Tip;
  n: number;
}

const { tip, n } = Astro.props;
const sources = sourcesFor(tip);
---

<article class="tip-row" id={tip.id} data-level={tip.level}>
  <a class="n" href={`#${tip.id}`} aria-label={`Link zu Tipp ${n}`}>{String(n).padStart(2, '0')}</a>
  <div>
    <h3>{tip.title} <span class={`badge badge-${tip.level.toLowerCase()}`}>{tip.level}</span></h3>
    <p>{tip.text}</p>
    {sources.length > 0 && (
      <ul class="src" aria-label="Quellen">
        {sources.map((s) => (
          <li>
            <a href={s.url} rel="noopener" title={`${s.title} (${s.type})`} class={s.type === 'offiziell' ? 'official' : undefined}>
              {s.type === 'offiziell' && <span class="dot" aria-hidden="true"></span>}
              <span class="t">{s.title}</span>
              <span class="sr-only"> ({s.type})</span>
            </a>
          </li>
        ))}
      </ul>
    )}
  </div>
</article>
