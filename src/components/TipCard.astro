---
import { sourcesFor, type Tip } from '../lib/tips';

interface Props {
  tip: Tip;
  category?: string;
}

const { tip, category } = Astro.props;
const sources = sourcesFor(tip);
---

<article
  class="tip"
  id={tip.id}
  data-level={tip.level}
  data-search={`${tip.title} ${tip.text} ${category ?? ''}`.toLowerCase()}
>
  <div class="tip-meta">
    <span class={`badge badge-${tip.level.toLowerCase()}`}>{tip.level}</span>
    {category && <span class="tip-cat">{category}</span>}
  </div>
  <h3>{tip.title}</h3>
  <p>{tip.text}</p>
  <p class="tip-src">
    Quelle:
    {sources.map((s, i) => (
      <>
        {i > 0 && ', '}
        <a href={s.url} rel="noopener">{s.title}</a> ({s.type})
      </>
    ))}
  </p>
</article>
