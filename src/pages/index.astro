---
import Base from '../layouts/Base.astro';
import TipCard from '../components/TipCard.astro';
import { allTips, categories, countByLevel, groups, levels } from '../lib/tips';

const counts = countByLevel(allTips.map((t) => t.tip));
const first = allTips[0];
const pool = allTips.map(({ tip, category }) => ({ title: tip.title, text: tip.text, cat: category.name, level: tip.level }));
---

<Base title="xurax – Tipps & Tricks für Claude">
  <section class="hero">
    <canvas class="hero-canvas" aria-hidden="true"></canvas>
    <div class="hero-copy">
      <p class="pill"><span data-count={allTips.length}>{allTips.length}</span> Tipps · <span data-count={categories.length}>{categories.length}</span> Kategorien · auf Deutsch</p>
      <h1>Mehr aus Claude herausholen.</h1>
      <p class="lead">Kurze, geprüfte Tipps für Claude.ai, Claude Code und die API. Jeder Tipp mit Level und Quelle.</p>
    </div>
    <div class="hero-actions">
      <div id="suche" class="search">
        <label for="q" class="sr-only">Tipps durchsuchen</label>
        <input id="q" type="search" placeholder="z. B. „CLAUDE.md“, „Halluzinationen“, „Shift+Tab“" autocomplete="off" />
      </div>
      <div class="chips" role="group" aria-label="Nach Level filtern">
        <button type="button" class="chip" data-level="" aria-pressed="true">Alle · {allTips.length}</button>
        {levels.map((l) => (
          <button type="button" class="chip" data-level={l} aria-pressed="false">{l} · {counts[l]}</button>
        ))}
      </div>
    </div>
  </section>

  <section id="zufall" class="featured" aria-labelledby="zufall-h">
    <div>
      <p id="zufall-h" class="eyebrow">Tipp des Tages · <span id="zufall-cat">{first.category.name}</span></p>
      <h2 id="zufall-title">{first.tip.title}</h2>
      <p id="zufall-text">{first.tip.text}</p>
    </div>
    <button type="button" id="zufall-next" class="button-secondary">Nächster Zufallstipp →</button>
  </section>

  <section id="kategorien" aria-labelledby="kat-h">
    <h2 id="kat-h">Kategorien</h2>
    {groups.map((g) => (
      <div class="cat-group">
        <h3 class="eyebrow muted-eyebrow">{g.name}</h3>
        <div class="cat-grid">
          {g.categories.map((c) => (
            <a class="cat" href={`/kategorie/${c.id}/`}>
              <span>{c.name}</span>
              <span class="count">{c.tips.length}</span>
            </a>
          ))}
        </div>
      </div>
    ))}
  </section>

  <section aria-labelledby="alle-h">
    <h2 id="alle-h">Alle Tipps <span id="treffer" class="muted"></span></h2>
    <div class="tip-grid" id="tips">
      {allTips.map(({ tip, category }) => <TipCard tip={tip} category={category.name} />)}
    </div>
    <p id="leer" class="muted" hidden>Kein Tipp gefunden. Versuch einen anderen Begriff.</p>
  </section>
</Base>

<script is:inline type="application/json" id="tip-pool" set:html={JSON.stringify(pool)} />

<script>
  import Fuse from 'fuse.js';
  import { popIn } from '../scripts/motion';

  type PoolTip = { title: string; text: string; cat: string; level: string };

  document.addEventListener('astro:page-load', () => {
    const poolEl = document.querySelector('#tip-pool');
    if (!poolEl) return;
    const pool: PoolTip[] = JSON.parse(poolEl.textContent!);

    // Tipp des Tages: pro Kalendertag fest, der Button zieht zufällig.
    const show = (i: number) => {
      const t = pool[i];
      document.querySelector('#zufall-title')!.textContent = t.title;
      document.querySelector('#zufall-text')!.textContent = t.text;
      document.querySelector('#zufall-cat')!.textContent = t.cat;
    };
    show(Math.floor(Date.now() / 864e5) % pool.length);
    document.querySelector('#zufall-next')!.addEventListener('click', () => show(Math.floor(Math.random() * pool.length)));

    // Unscharfe Suche: findet auch Tippfehler wie „halluzinatonen“.
    const fuse = new Fuse(pool, {
      keys: [{ name: 'title', weight: 2 }, 'text', 'cat'],
      threshold: 0.35,
      ignoreLocation: true,
    });
    const q = document.querySelector<HTMLInputElement>('#q')!;
    const chips = [...document.querySelectorAll<HTMLButtonElement>('.chip')];
    const tips = [...document.querySelectorAll<HTMLElement>('#tips .tip')];
    const treffer = document.querySelector('#treffer')!;
    const leer = document.querySelector<HTMLElement>('#leer')!;
    let level = '';

    function apply() {
      const query = q.value.trim();
      const hits = query ? new Set(fuse.search(query).map((r) => r.refIndex)) : null;
      const appeared: HTMLElement[] = [];
      let shown = 0;
      tips.forEach((el, i) => {
        const ok = (!level || pool[i].level === level) && (!hits || hits.has(i));
        if (ok && el.hidden) appeared.push(el);
        el.hidden = !ok;
        if (ok) shown++;
      });
      treffer.textContent = `(${shown})`;
      leer.hidden = shown > 0;
      popIn(appeared);
    }

    q.addEventListener('input', apply);
    for (const chip of chips) {
      chip.addEventListener('click', () => {
        level = chip.dataset.level ?? '';
        chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
        apply();
      });
    }
    apply();
  });
</script>
