---
import '@fontsource-variable/inter';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Kurze, geprüfte Tipps für Claude.ai, Claude Code und die API. Auf Deutsch.' } = Astro.props;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <ClientRouter />
    <script is:inline>
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('motion');
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="container header-row">
        <a href="/" class="logo"><span class="logo-mark">x</span>xurax</a>
        <nav aria-label="Hauptnavigation">
          <a href="/#kategorien" class="opt">Kategorien</a>
          <a href="/#zufall" class="opt">Zufallstipp</a>
        </nav>
        <a href="/#suche" class="hsearch" data-search-open>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
          <span>Suchen</span><kbd>/</kbd>
        </a>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container footer-row">
        <div>
          <p><b>xurax.de</b>: 150 Tipps und Tricks für Claude, kostenlos und ohne Anmeldung.</p>
          <p>Gesammelt aus der offiziellen Anthropic-Dokumentation und der Community. Inoffiziell, nicht mit Anthropic verbunden.</p>
        </div>
        <nav aria-label="Fußzeile">
          <a href="/#kategorien">Kategorien</a>
          <a href="/#start">Für Einsteiger</a>
        </nav>
      </div>
    </footer>
    <script>
      import '../scripts/motion';
      import '../scripts/site';
    </script>
  </body>
</html>
